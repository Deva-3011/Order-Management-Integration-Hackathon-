    <http:listener-config name="order-management-apiraml-httpListenerConfig" method="PUT" body="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    customerId: vars.order.customerId,&#10;    productId: vars.order.productId,&#10;    quantity: vars.order.quantity&#10;}]" path="/external/orders" doc:id="ebe11af8-8036-4c2f-9159-4d5ca81cd307" config-ref="HTTP_Request_configuration_2" targetValue="#[payload]">
