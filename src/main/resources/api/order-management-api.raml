#%RAML 1.0

title: Order Management API
version: v1
baseUri: /api

/orders:
  post:
    description: Create a customer order

    body:
      application/json:
        type: object
        properties:
          customerId:
            type: string
            required: true

          customerName:
            type: string
            required: true

          email:
            type: string
            required: true

          items:
            type: array
            minItems: 1
            required: true

            items:
              type: object
              properties:
                productId:
                  type: string
                  required: true

                quantity:
                  type: integer
                  minimum: 1
                  required: true

        example:
          {
            "customerId": "C101",
            "customerName": "Rupali",
            "email": "rupali@gmail.com",
            "items": [
              {
                "productId": "P101",
                "quantity": 2
              }
            ]
          }

    responses:

      201:
        description: Order created successfully
        body:
          application/json:
            example:
              {
                "status": "SUCCESS",
                "orderId": "ORD1001",
                "customerId": "C101",
                "subtotal": 12000,
                "discount": 1200,
                "totalAmount": 10800,
                "message": "Order created successfully",
                "correlationId": "123e4567-e89b-12d3-a456-426614174000"
              }

      400:
        description: Invalid order request
        body:
          application/json:
            example:
              {
                "status": "ERROR",
                "message": "customerId must not be blank",
                "correlationId": "123e4567-e89b-12d3-a456-426614174000"
              }

      404:
        description: Product not found
        body:
          application/json:
            example:
              {
                "status": "ERROR",
                "errorCode": "PRODUCT_NOT_FOUND",
                "message": "Product was not found",
                "correlationId": "123e4567-e89b-12d3-a456-426614174000"
              }

      409:
        description: Insufficient stock
        body:
          application/json:
            example:
              {
                "status": "ERROR",
                "errorCode": "INSUFFICIENT_STOCK",
                "message": "Insufficient stock",
                "correlationId": "123e4567-e89b-12d3-a456-426614174000"
              }

      500:
        description: Internal server error
        body:
          application/json:
            example:
              {
                "status": "ERROR",
                "errorCode": "INTERNAL_ERROR",
                "message": "Unexpected error occurred",
                "correlationId": "123e4567-e89b-12d3-a456-426614174000"
              }